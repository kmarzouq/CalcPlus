<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/window_bg"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingBottom="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/historyButton"
            style="@style/ToolbarIcon"
            android:src="@drawable/ic_history"
            android:contentDescription="@string/cd_history" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/settingsButton"
            style="@style/ToolbarIcon"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/cd_settings" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <TextView
                android:id="@+id/formula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:ellipsize="start"
                android:textColor="@color/display_text"
                android:textSize="@dimen/display_formula_text"
                android:textIsSelectable="true"
                android:fontFamily="sans-serif-light" />

            <TextView
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:ellipsize="start"
                android:minHeight="30dp"
                android:textColor="@color/result_text"
                android:textSize="@dimen/display_result_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/angleToggle"
                    style="@style/CalcChip"
                    android:text="RAD" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/sciToggle"
                    style="@style/CalcChip"
                    android:text="@string/sci_toggle"
                    android:contentDescription="@string/cd_sci" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/divider" />

            <include
                android:id="@+id/sciPad"
                layout="@layout/keypad_scientific"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <include
                android:id="@+id/numPad"
                layout="@layout/keypad_numeric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
