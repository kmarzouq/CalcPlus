<?xml version="1.0" encoding="utf-8"?>
<!--
  Programmer calculator widget (64-bit signed). One layout; ProgWidgetProvider
  builds RemoteViews per size bucket and only varies text sizes. The BASE key
  cycles the readout HEX -> DEC -> BIN.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/wpDisplayArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.75"
        android:orientation="vertical"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="6dp">

        <TextView
            android:id="@+id/wpFormula"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="start"
            android:fontFamily="monospace"
            android:textColor="@color/widget_display_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/wpResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="start"
            android:fontFamily="monospace"
            android:textColor="@color/widget_result_text"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout style="@style/WidgetRow">
        <Button android:id="@+id/wpBase" style="@style/WidgetKey.Op" android:text="BASE" />
        <Button android:id="@+id/wpShl" style="@style/WidgetKey.Op" android:text="«" />
        <Button android:id="@+id/wpShr" style="@style/WidgetKey.Op" android:text="»" />
        <Button android:id="@+id/wpAnd" style="@style/WidgetKey.Op" android:text="AND" />
        <Button android:id="@+id/wpOr" style="@style/WidgetKey.Op" android:text="OR" />
        <Button android:id="@+id/wpXor" style="@style/WidgetKey.Op" android:text="XOR" />
    </LinearLayout>

    <LinearLayout style="@style/WidgetRow">
        <Button android:id="@+id/wpNot" style="@style/WidgetKey.Op" android:text="NOT" />
        <Button android:id="@+id/wpRol" style="@style/WidgetKey.Op" android:text="RoL" />
        <Button android:id="@+id/wpRor" style="@style/WidgetKey.Op" android:text="RoR" />
        <Button android:id="@+id/wpLparen" style="@style/WidgetKey.Op" android:text="(" />
        <Button android:id="@+id/wpRparen" style="@style/WidgetKey.Op" android:text=")" />
        <Button android:id="@+id/wpClear" style="@style/WidgetKey"
            android:text="@string/key_clear" android:textColor="@color/widget_key_clear_text" />
    </LinearLayout>

    <LinearLayout style="@style/WidgetRow">
        <Button android:id="@+id/wpA" style="@style/WidgetKey" android:text="A" />
        <Button android:id="@+id/wpB" style="@style/WidgetKey" android:text="B" />
        <Button android:id="@+id/wpC" style="@style/WidgetKey" android:text="C" />
        <Button android:id="@+id/wpD" style="@style/WidgetKey" android:text="D" />
        <Button android:id="@+id/wpE" style="@style/WidgetKey" android:text="E" />
        <Button android:id="@+id/wpDelete" style="@style/WidgetKey" android:text="@string/key_delete" />
    </LinearLayout>

    <LinearLayout style="@style/WidgetRow">
        <Button android:id="@+id/wp7" style="@style/WidgetKey" android:text="7" />
        <Button android:id="@+id/wp8" style="@style/WidgetKey" android:text="8" />
        <Button android:id="@+id/wp9" style="@style/WidgetKey" android:text="9" />
        <Button android:id="@+id/wpF" style="@style/WidgetKey" android:text="F" />
        <Button android:id="@+id/wpMod" style="@style/WidgetKey.Op" android:text="MOD" />
        <Button android:id="@+id/wpDiv" style="@style/WidgetKey.Op" android:text="@string/key_divide" />
    </LinearLayout>

    <LinearLayout style="@style/WidgetRow">
        <Button android:id="@+id/wp4" style="@style/WidgetKey" android:text="4" />
        <Button android:id="@+id/wp5" style="@style/WidgetKey" android:text="5" />
        <Button android:id="@+id/wp6" style="@style/WidgetKey" android:text="6" />
        <Button android:id="@+id/wp0" style="@style/WidgetKey" android:text="0" />
        <Button android:id="@+id/wpNeg" style="@style/WidgetKey" android:text="@string/key_negate" />
        <Button android:id="@+id/wpMul" style="@style/WidgetKey.Op" android:text="@string/key_multiply" />
    </LinearLayout>

    <LinearLayout style="@style/WidgetRow">
        <Button android:id="@+id/wp1" style="@style/WidgetKey" android:text="1" />
        <Button android:id="@+id/wp2" style="@style/WidgetKey" android:text="2" />
        <Button android:id="@+id/wp3" style="@style/WidgetKey" android:text="3" />
        <Button android:id="@+id/wpSub" style="@style/WidgetKey.Op" android:text="@string/key_subtract" />
        <Button android:id="@+id/wpAdd" style="@style/WidgetKey.Op" android:text="@string/key_add" />
        <Button android:id="@+id/wpEquals" style="@style/WidgetKey.Equals" android:text="@string/key_equals" />
    </LinearLayout>
</LinearLayout>
