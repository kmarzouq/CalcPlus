<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalcRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="CalcChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:background">@drawable/key_background</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Default = the collapsed look: circular keys. MainActivity swaps the
         numeric keys to the rounded-rect drawables when the scientific pad
         is expanded (like the stock calculator). -->
    <style name="CalcKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:layout_margin">@dimen/key_margin</item>
        <item name="android:background">@drawable/key_circle</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">@dimen/key_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CalcKey.Op">
        <item name="android:background">@drawable/key_circle_accent</item>
        <item name="android:textColor">@color/key_text_op</item>
    </style>

    <style name="CalcKey.Clear">
        <item name="android:textColor">@color/key_text_clear</item>
    </style>

    <style name="CalcKey.Equals">
        <item name="android:background">@drawable/key_circle_equals</item>
        <item name="android:textColor">@color/key_text_equals</item>
    </style>

    <!-- Scientific keys are only visible when expanded, so they are always
         rounded rectangles. -->
    <style name="CalcKey.Sci">
        <item name="android:background">@drawable/key_background</item>
        <item name="android:textColor">@color/key_text_op</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Programmer keypad: dense 6-wide grid, always rounded rectangles. -->
    <style name="CalcKey.Prog">
        <item name="android:background">@drawable/key_background</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="CalcKey.Prog.Op">
        <item name="android:background">@drawable/key_background_accent</item>
        <item name="android:textColor">@color/key_text_op</item>
    </style>

    <style name="CalcKey.Prog.Equals">
        <item name="android:background">@drawable/key_background_equals</item>
        <item name="android:textColor">@color/key_text_equals</item>
    </style>

    <style name="CalcKey.Prog.Clear">
        <item name="android:textColor">@color/key_text_clear</item>
    </style>

    <style name="StepperValue">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/display_text</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- Programmer multi-base readout rows -->
    <style name="ProgBaseRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="ProgBaseLabel">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/result_text</item>
    </style>

    <style name="ProgBaseValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">start</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/result_text</item>
        <item name="android:text">0</item>
    </style>

    <!-- Widget keypad -->
    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="WidgetKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:background">@drawable/widget_key</item>
        <item name="android:textColor">@color/widget_key_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="WidgetKey.Op">
        <item name="android:background">@drawable/widget_key_op</item>
        <item name="android:textColor">@color/widget_key_op_text</item>
    </style>

    <style name="WidgetKey.Equals">
        <item name="android:background">@drawable/widget_key_eq</item>
        <item name="android:textColor">@color/widget_key_eq_text</item>
    </style>

    <!-- App bar (Settings / History) -->
    <style name="AppBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">8dp</item>
    </style>

    <style name="AppBarIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="AppBarTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/display_text</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/key_text_op</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="SettingRadio">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">@color/display_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">@color/display_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">3dp</item>
        <item name="android:textColor">@color/result_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="ToolbarIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
    </style>
</resources>
