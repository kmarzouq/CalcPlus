<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No <uses-permission> of any kind. Not INTERNET, not POST_NOTIFICATIONS.
      A calculator needs nothing. Keep this file permission-free forever.
    -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:memtagMode="sync"
        android:supportsRtl="true"
        android:theme="@style/Theme.Calculator">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".GraphActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ProgrammerActivity"
            android:exported="false"
            android:configChanges="keyboardHidden"
            android:parentActivityName=".MainActivity" />

        <!-- Interactive calculator widgets. Every key is a self-targeted
             broadcast, so they work on the home screen and, on Android 16
             QPR2+ / GrapheneOS, the lock screen widget page. -->
        <receiver
            android:name=".widget.CalculatorWidgetProvider"
            android:exported="true"
            android:label="@string/widget_basic_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calculator_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SciWidgetProvider"
            android:exported="true"
            android:label="@string/widget_sci_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sci_info" />
        </receiver>

        <receiver
            android:name=".widget.ProgWidgetProvider"
            android:exported="true"
            android:label="@string/widget_prog_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_prog_info" />
        </receiver>
    </application>

</manifest>
